DATABASE_URL="postgresql://kindcaddy:kindcaddy_dev@localhost:5432/kindcaddy"

# --- Auth (PRODUCTION-PLAN.md Phase 1.2) ---
# Random 32+ char secret. Required in production (Auth.js + OAuth state HMAC).
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-generate-a-32-char-secret"
# Resend API key for magic-link sign-in emails (https://resend.com).
# Without it, dev logs the magic link to the server console; production refuses.
# AUTH_RESEND_KEY=""
# EMAIL_FROM="KindCaddy <hello@kindcaddy.ai>"
# Google sign-in (optional). Falls back to GOOGLE_CLIENT_ID/SECRET below.
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# Allow linking Google sign-in to existing accounts by email. Only enable
# if every provider verifies email ownership.
# AUTH_ALLOW_EMAIL_LINKING="false"

# --- Security (Phase 3) ---
# Public origin of this deployment; used by the CSRF origin check in withGuard.
# APP_ORIGIN="https://app.kindcaddy.ai"
# AES-256-GCM key for integration secrets in Resource.data (KMS-managed in AWS).
# RESOURCE_ENCRYPTION_KEY=""

# --- Google Calendar integration (manualplugs §5.1) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"

# --- QuickBooks Online integration ---
# Create an Intuit app at https://developer.intuit.com/app/developer/qbo
# Set the redirect URI in the Intuit app to match QBO_REDIRECT_URI below.
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
QBO_REDIRECT_URI="http://localhost:3000/api/integrations/quickbooks/callback"
# "sandbox" (default) or "production"
QBO_ENV="sandbox"

# Optional: use a real OpenAI-compatible LLM for KindCaddy's orchestrator.
# Without this, the app uses the deterministic MockLLMProvider.
# OPENAI_API_KEY=""
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4o-mini"

# --- Hermes Agent bridge (the AI "box": local model + frontier fallback) ---
# Enable Hermes' API server separately with API_SERVER_ENABLED=true.
HERMES_AGENT_BASE_URL="http://127.0.0.1:8642/v1"
HERMES_AGENT_API_KEY="change-me-local-dev"
HERMES_AGENT_MODEL="hermes-agent"

# --- Admission control & timeout budget (Phase 2) ---
# Per-round Hermes call timeout.
HERMES_AGENT_TIMEOUT_MS="60000"
# Max LLM->tools rounds per turn.
HERMES_AGENT_MAX_TOOL_ROUNDS="5"
# Overall per-turn deadline across all rounds.
HERMES_AGENT_TURN_BUDGET_MS="180000"
# Global chat semaphore — size to local-model batch capacity.
MAX_CONCURRENT_CHAT_TURNS="8"
