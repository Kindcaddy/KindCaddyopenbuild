DATABASE_URL="file:./dev.db"

# Optional: use a real OpenAI-compatible LLM for KindCaddy's orchestrator.
# Without this, the app uses the deterministic MockLLMProvider.
# OPENAI_API_KEY=""
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4o-mini"

# Optional: connect KindCaddy's hermes-agent MCP bridge to Nous Hermes Agent.
# Enable Hermes' API server separately with API_SERVER_ENABLED=true.
HERMES_AGENT_BASE_URL="http://127.0.0.1:8642/v1"
HERMES_AGENT_API_KEY="change-me-local-dev"
HERMES_AGENT_MODEL="hermes-agent"
HERMES_AGENT_TIMEOUT_MS="120000"

# ---------- Envelope encryption for OAuth tokens at rest ----------
# 'local' uses APP_ENC_KEY (dev/CI). 'aws-kms' uses KMS_KEY_ID (production).
ENC_PROVIDER="local"
# Required when ENC_PROVIDER=local. Generate with: openssl rand -base64 32
APP_ENC_KEY="change-me-generate-with-openssl-rand-base64-32"
# Required when ENC_PROVIDER=aws-kms. Set to the CMK ARN or alias.
# KMS_KEY_ID="arn:aws:kms:us-east-1:123456789012:alias/kindcaddy-resource-data"

# ---------- Google Calendar (already wired) ----------
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"

# ---------- QuickBooks Online (real integration) ----------
# Create an app at https://developer.intuit.com/ and put its sandbox or
# production credentials here. Leave blank to keep QuickBooks disconnected.
# QUICKBOOKS_CLIENT_ID=""
# QUICKBOOKS_CLIENT_SECRET=""
# QUICKBOOKS_REDIRECT_URI="http://localhost:3000/api/integrations/quickbooks/callback"
# 'sandbox' for development, 'production' for live data.
QUICKBOOKS_ENVIRONMENT="sandbox"
