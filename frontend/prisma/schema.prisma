// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String    @default("")
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships     Membership[]
  mcpDomainAccess UserMcpDomainAccess[]
  accounts        Account[]
  authSessions    Session[]
}

// ---------- Auth.js (NextAuth v5) models ----------
// These back the sign-in flow only. The app's own session contract stays the
// `auth_session` cookie set by lib/auth.ts after onboarding (see
// app/api/auth/bridge). PRODUCTION-PLAN.md Phase 1.2.

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments     Department[]
  memberships     Membership[]
  resources       Resource[]
  mcpDomains      TenantMcpDomain[]
  mcpDomainAccess UserMcpDomainAccess[]
  invites         Invite[]
}

model TenantMcpDomain {
  id        String   @id @default(cuid())
  tenantId  String
  domain    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, domain])
  @@index([tenantId])
}

// Per-user (employee) override of which MCP domains they can use within a tenant.
// Absence of a row means "allowed by default". Used by admins to restrict
// individual employees' access to specific MCP domains.
model UserMcpDomainAccess {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  domain    String
  allowed   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId, domain])
  @@index([userId])
  @@index([tenantId])
}

model Department {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]
  resources   Resource[]
  invites     Invite[]
}

model Membership {
  id           String   @id @default(cuid())
  userId       String
  tenantId     String
  departmentId String
  role         String   // 'admin' | 'employee'
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId, departmentId])
  @@index([userId])
  @@index([tenantId])
}

// ---------- Invites ----------
// An invite link lets any signed-in user bring a teammate into their tenant.
// The invitee signs up/in through /login?invite=<token>; /api/auth/bridge
// redeems the token and creates an `employee` Membership in the inviter's
// tenant + department INSTEAD of provisioning a fresh tenant (see
// lib/onboarding.ts). One live invite per (tenant, email): re-inviting
// rotates the token and expiry. Rows are kept after acceptance as an audit
// trail; acceptedAt double-clicks are idempotent for the same user.

model Invite {
  id           String    @id @default(cuid())
  token        String    @unique
  email        String
  tenantId     String
  departmentId String
  inviterId    String
  role         String    @default("employee")
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([inviterId])
}

model Resource {
  id           String   @id @default(cuid())
  tenantId     String
  departmentId String
  name         String
  data         String   @default("{}") // JSON string
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([departmentId])
}

// Persisted record of every unexpected server-side failure. Unlike log lines,
// rows carry a triage workflow (open -> acknowledged -> resolved) so errors
// stay visible until a human has dealt with them. See PRODUCTION-PLAN.md
// Phase 0. Policy denials are NOT errors and never land here.
model ErrorReport {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  // Correlates the x-request-id response header, server logs, and Hermes calls.
  requestId  String
  route      String // e.g. "POST /api/mcp/chat" or "mcp.invoke"
  userId     String? // null for unauthenticated / system failures
  tenantId   String?
  code       String // stable machine code, e.g. 'hermes_unreachable'
  message    String
  // Server-side only; never serialized into client responses.
  stack      String?
  context    String    @default("{}") // JSON: sessionId, tool, round, etc.
  severity   String    @default("error") // 'warning' | 'error' | 'fatal'
  status     String    @default("open") // 'open' | 'acknowledged' | 'resolved'
  resolvedAt DateTime?
  resolvedBy String? // admin userId
  resolution String? // what was fixed / why it was safe to ignore

  @@index([status])
  @@index([code])
  @@index([tenantId])
  @@index([createdAt])
}

model AuditEvent {
  id          String   @id @default(cuid())
  userId      String?
  tenantId    String?
  action      String
  resourceType String?
  resourceId  String?
  metadata    String   @default("{}") // JSON string
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([tenantId])
  @@index([createdAt])
}

// ---------- MCP Framework: session / memory / tool-call state ----------

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  title     String   @default("New conversation")
  // JSON: free-form working memory maintained by the Host (facts, goals, scratchpad)
  memory    String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@index([userId])
  @@index([tenantId])
  @@index([updatedAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  // 'user' | 'assistant' | 'system' | 'tool'
  role      String
  // For assistant messages: which agent produced it (e.g. 'openclaw', 'hermes', 'host')
  agent     String?
  content   String
  // JSON: optional structured payload (plan steps, tool call metadata, citations)
  metadata  String   @default("{}")
  createdAt DateTime @default(now())

  session     ChatSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  invocations ToolInvocation[]

  @@index([sessionId])
  @@index([createdAt])
}

model ToolInvocation {
  id         String   @id @default(cuid())
  messageId  String
  sessionId  String
  // e.g. 'sqlite', 'files', 'netsuite', 'quickbooks'
  server     String
  // e.g. 'sqlite.query', 'files.read'
  tool       String
  // JSON request params
  params     String   @default("{}")
  // JSON normalized result (or error)
  result     String   @default("{}")
  status     String   @default("pending") // 'pending' | 'ok' | 'error' | 'denied'
  latencyMs  Int      @default(0)
  createdAt  DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([server])
  @@index([createdAt])
}

// ---------- Per-user memory layer (Smart / Explicit modes) ----------
//
// Scoped per (userId, tenantId) exactly like ChatSession — a user in two
// tenants keeps two separate memory sets, and every read/write filters on both
// ids so one user's memory can never surface in another's answer. Rows are
// user-visible and deletable (see /api/memory) and purged by DELETE /api/me.

model UserMemory {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  content   String
  // Optional short label for the UI (e.g. "Preference", "Project").
  label     String?
  // How the item was captured: 'smart' (auto-extracted) | 'explicit' (saved).
  source    String   @default("explicit")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Soft-hide without deleting; also lets injection skip archived items.
  archivedAt DateTime?
  // NOTE: a nullable pgvector `embedding` column is intentionally deferred.
  // The (userId, tenantId, createdAt) shape leaves room to add semantic
  // retrieval later without reshaping reads.

  @@index([userId, tenantId])
  @@index([createdAt])
}

model UserMemorySetting {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  // Capture mode: 'smart' (auto-extract, default) | 'explicit' | 'off'.
  mode      String   @default("smart")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
}
