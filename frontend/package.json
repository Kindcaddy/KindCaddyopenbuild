    "better-sqlite3": "^12.6.2",
    "cookie": "^1.1.1",
    "dotenv": "^17.2.3",
    "googleapis": "^171.4.0",
    "lucide-react": "^0.344.0",
    "next": "^14.2.5",
    "prisma": "^7.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie": "^0.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
