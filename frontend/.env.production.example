# --- Core ---
DATABASE_URL="postgresql://kindcaddy:***@<rds-endpoint>:5432/kindcaddy?sslmode=require"
NODE_ENV="production"
APP_ORIGIN="https://app.kindcaddy.com"

# --- Auth (Auth.js v5) ---
AUTH_SECRET=*** rand -base64 32>"
AUTH_TRUST_HOST="true"
AUTH_RESEND_KEY=*** contact.kindcaddy.com>"
# Google sign-in (optional):
# AUTH_GOOGLE_ID=*** AUTH_GOOGLE_SECRET=*** AUTH_ALLOW_EMAIL_LINKING=*** --- Security ---
RESOURCE_ENCRYPTION_KEY=*** rand -base64 32>"

# --- LLM provider (OpenAI-compatible; OpenRouter in production) ---
# Platform default key. Per-user BYOK (checklist W8) overrides this later.
OPENAI_API_KEY=*** OPENAI_BASE_URL="https://openrouter.ai/api/v1"
OPENAI_MODEL="anthropic/claude-sonnet-4"
# Optional cheaper model for Smart-memory extraction (defaults to OPENAI_MODEL):
# OPENAI_MEMORY_MODEL="openai/gpt-4o-mini"

# --- QuickBooks Online (optional integration) ---
# QBO_CLIENT_ID=*** QBO_CLIENT_SECRET=*** QBO_REDIRECT_URI="https://app.kindcaddy.com/api/integrations/quickbooks/callback"
# QBO_ENV="sandbox"

# --- Admission control & timeout budget ---
LLM_TIMEOUT_MS="60000"
LLM_MAX_TOOL_ROUNDS="5"
LLM_TURN_BUDGET_MS="180000"
LLM_MEMORY_TIMEOUT_MS="15000"
MAX_CONCURRENT_CHAT_TURNS="8"
