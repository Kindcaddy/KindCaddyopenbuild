# --- Core ---
# Format: postgresql://DBUSER:DBPASS@DBHOST:5432/kindcaddy?sslmode=require
DATABASE_URL=""
NODE_ENV="production"
APP_ORIGIN="https://app.kindcaddy.com"

# --- Auth (Auth.js v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
AUTH_URL="https://app.kindcaddy.com"
# Resend API key for magic-link sign-in emails (https://resend.com).
AUTH_RESEND_KEY=""
EMAIL_FROM="KindCaddy <hello@contact.kindcaddy.com>"
# Google sign-in (optional):
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# AUTH_ALLOW_EMAIL_LINKING="false"

# --- Security ---
# AES-256-GCM key for integration secrets in Resource.data.
# Generate with: openssl rand -base64 32
RESOURCE_ENCRYPTION_KEY=""

# --- LLM provider (OpenAI-compatible; OpenRouter in production) ---
# Platform default key. Per-user BYOK (Configuration page) overrides this per
# browser session; the key below remains the fallback for users without BYOK.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://openrouter.ai/api/v1"
OPENAI_MODEL="anthropic/claude-sonnet-4"
# Optional cheaper model for Smart-memory extraction (defaults to OPENAI_MODEL):
# OPENAI_MEMORY_MODEL="openai/gpt-4o-mini"

# --- QuickBooks Online (optional integration) ---
# From https://developer.intuit.com -> My Apps -> your app -> Keys & credentials.
# The redirect URI must be registered in the Intuit app settings.
# QBO_CLIENT_ID=""
# QBO_CLIENT_SECRET=""
# QBO_REDIRECT_URI="https://app.kindcaddy.com/api/integrations/quickbooks/callback"
# QBO_ENV="sandbox"

# --- Admission control & timeout budget ---
LLM_TIMEOUT_MS="60000"
LLM_MAX_TOOL_ROUNDS="5"
LLM_TURN_BUDGET_MS="180000"
LLM_MEMORY_TIMEOUT_MS="15000"
MAX_CONCURRENT_CHAT_TURNS="8"
