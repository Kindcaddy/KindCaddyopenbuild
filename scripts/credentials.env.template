# KindCaddy deploy credentials — TEMPLATE.
#
# Setup (one time, by the human):
#   mkdir -p ~/.kindcaddy-deploy && chmod 700 ~/.kindcaddy-deploy
#   cp scripts/credentials.env.template ~/.kindcaddy-deploy/credentials.env
#   chmod 600 ~/.kindcaddy-deploy/credentials.env
#   # fill every placeholder below; then run: scripts/deploy-ec2.sh --gen-secrets
#
# RULES: this file never leaves your Mac, never enters git, is never opened
# by any model. scripts/deploy-ec2.sh sources it directly; operators (human
# or local model) only ever run script commands and see sanitized output.

# --- EC2 access (not secret values, but treat as sensitive) ---
EC2_HOST="REPLACE_ME"                 # Elastic IP, e.g. 54.210.11.23
EC2_USER="ubuntu"
EC2_SSH_KEY="REPLACE_ME"              # path to your .pem, e.g. /Users/jimmy/.ssh/kindcaddy-ec2.pem

# --- Database (RDS endpoint is NOT secret; DB_PASSWORD is) ---
RDS_ENDPOINT="REPLACE_ME"             # from scripts/provision-rds.sh output, e.g. kindcaddy-prod.abc123.us-east-1.rds.amazonaws.com
DB_PASSWORD="GENERATE"                # leave as GENERATE; --gen-secrets fills it

# --- App secrets ---
AUTH_SECRET="GENERATE"                # leave as GENERATE
RESOURCE_ENCRYPTION_KEY="GENERATE"    # leave as GENERATE
AUTH_RESEND_KEY="REPLACE_ME"          # from https://resend.com/api-keys
EMAIL_FROM="KindCaddy <hello@contact.kindcaddy.com>"

# --- LLM provider (platform default key; per-user BYOK comes in W8) ---
OPENAI_API_KEY="REPLACE_ME"           # from https://openrouter.ai/keys
OPENAI_MODEL="anthropic/claude-sonnet-4"
